{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/contact-us",
      "destination": "/#enquiry",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#enquiry",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/book-online",
      "destination": "/#enquiry",
      "permanent": true
    },
    {
      "source": "/booking",
      "destination": "/#enquiry",
      "permanent": true
    },
    {
      "source": "/bookings",
      "destination": "/#enquiry",
      "permanent": true
    },
    {
      "source": "/areas-we-cover",
      "destination": "/#areas",
      "permanent": true
    },
    {
      "source": "/prices",
      "destination": "/#estimate",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/#estimate",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/post/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/our-services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/service",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gallery/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/booking-calendar/:path*",
      "destination": "/#enquiry",
      "permanent": true
    },
    {
      "source": "/service-page/:path*",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/services/:path*",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blank",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile-tyre-fitting",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tyres",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/emergency-tyre-fitting",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/#reviews",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.resqtyres.co.uk"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-BdWgnXC6caN2yyupmXKYK8ZROpsLzUYw75E3I4OZe4s=' 'sha256-Lah+5g5CSOu7tIorjVrXdBXmPThpUNkhW2AmQo3Mgkk=' 'sha256-Uo0qWPbCBfjFx3oSN+m8az9zh+/E7i3KmYGfcFwPe7I=' 'sha256-io0cuIvhqrXcaeXzF6PK10WK/lcPaUPDeFwbgw5HnmQ=' 'sha256-tHd4qJ0R/vQfI0CbRTiL3XGSi+Tun7VhOcDbx08aLKA=' 'unsafe-hashes' 'sha256-p5PnWJvMOnsZyLjxblLBMDwBfOASHA7CQcLYb5mwepY=' https://www.googletagmanager.com https://www.gstatic.com https://www.googleadservices.com https://googleads.g.doubleclick.net https://www.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google.com https://www.google.co.uk https://www.googletagmanager.com https://*.google-analytics.com https://*.doubleclick.net https://googleads.g.doubleclick.net; font-src 'self'; connect-src 'self' https://docs.google.com https://api.web3forms.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.doubleclick.net https://googleads.g.doubleclick.net https://www.google.com https://www.google.co.uk https://www.googleadservices.com; frame-src https://www.googletagmanager.com https://td.doubleclick.net https://*.doubleclick.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'"
        }
      ]
    }
  ]
}
